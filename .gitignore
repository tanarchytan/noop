# ── Misc / secrets (never commit) ───────────────────────────────
*.log
.env
# Deployment credentials (PAT / signing / endpoints) — never commit. `.env` above
# won't match `deploy.env`, so list it (and any `deploy.env.<stage>`) explicitly.
deploy.env
deploy.env.*
secrets.*
android/local.properties
android/keystore.properties
android/noop-release.jks

# ── Personal data — NEVER publish (real WHOOP/Apple Health exports) ──
Fixtures/
*.sqlite
*.sqlite-wal
*.sqlite-shm
export.xml
export.zip
*whoop_export*.zip
*apple_health*.zip

# Python bytecode
__pycache__/
*.pyc

# Local release artifacts (zips/apks built for upload; never tracked)
dist/
err.txt

# Working notes live OUTSIDE the repo, in ../dev-notes/noop-tan/ — plans, reviews and cleanup
# queues rot, and keeping them out of the tree means they can never be mistaken for docs.
# These two stay ignored so an older checkout does not resurrect them.
dev-docs/
dev-notes/

# Device screenshots and scratch captures taken while testing on hardware. Ignored because a
# blanket stage has swept them into a commit before — and did again: 15 phone-*.png (11.8 MB) had
# been sitting in Tools/ unreferenced. A capture belongs in .dev-screens/ or outside the repo; a
# screenshot that documents something belongs in docs/assets/ with a reference to it.
.dev-screens/
phone-*.png
screencap*.png
