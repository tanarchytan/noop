Icon?

# ── Build output ────────────────────────────────────────────────
build/

# ── Android (Gradle / Studio) ───────────────────────────────────
android/.gradle/
android/build/
android/app/build/
android/captures/
android/local.properties
android/.idea/
android/*.iml
